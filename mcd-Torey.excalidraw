      "boundElements": [],
      "updated": 1782998968366,
      "link": null,
      "locked": false,
      "text": "Products()\nid\nbrand_id\nname\ndescription\nbase_price\nis_best_seller\nimg_url -> json containing the names of the images \n[\"nike_front.jpg\", \"nike_side.jpg\", \"nike_top.jpg\", \"nike_sole.jpg\"]\n\na product can be part of multiple collection?\n->create a junction table to link collection_id to product_id as a PK\n\nCollection\nid\nname\ndescription\nimage_url\nis_active\nis_limited (eg. marathon or carbon shoes ?)\nreleased_date\ncreated_at\n\n\nCategories(men women)\nid\nname\n\nBrands(brand details)\nid\nname\n\nReviews\nid\nproduct_id\nuser_id\nrating(not null)\ncomment (text)\nverified_purchase\ncreated_at\n(one review per customer)\n\nProduct_variants\nid\nsize(changes according to the country ?)\ncolor\nsku(stock keeping unit [brand-model-color-size])\nprice_override null?\n\nDiscounts\nid\ncode\ndiscout_type(%or fixed)\nvalue\nstart_date\nend_date\nnumber_of_uses\nis_active\n\nCity\nid\ncity_name\n(fk)its own shipping rule\n\nShipping_rules\nid\nrule_name\nprice\nfree_shipping_threshold (minimal amount to get free shipping)\n\nOrders\nid\nuser_id\ndiscount_id\nsubtotal (total amount to be calculated later)\nshipping_status(pending, shipped, delivered, cancelled)\ncity\nshipping_fee (at that time )\ntransaction_id?\ncreated_at\n\nOrder_items\nid\nquality\nprice_at_purchase\n\nUser&Admin\nid\nfirst_name\nlast_name\nemail\npassword_hash\nrole(customer || admin)\ncreated_at\n\nRefunds(to log refund transactions)\nid\norder_id\nadmin_user_id(admin who approved the refund)\namount\nreason\nstatus(pending, processed, failed)\ncreated_at\n\nrefund_items(tracking items came back)\nid\nrefund_id\nvariant_id\nquantity\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Products()\nid\nbrand_id\nname\ndescription\nbase_price\nis_best_seller\nimg_url -> json containing the names of the images \n[\"nike_front.jpg\", \"nike_side.jpg\", \"nike_top.jpg\", \"nike_sole.jpg\"]\n\na product can be part of multiple collection?\n->create a junction table to link collection_id to product_id as a PK\n\nCollection\nid\nname\ndescription\nimage_url\nis_active\nis_limited (eg. marathon or carbon shoes ?)\nreleased_date\ncreated_at\n\n\nCategories(men women)\nid\nname\n\nBrands(brand details)\nid\nname\n\nReviews\nid\nproduct_id\nuser_id\nrating(not null)\ncomment (text)\nverified_purchase\ncreated_at\n(one review per customer)\n\nProduct_variants\nid\nsize(changes according to the country ?)\ncolor\nsku(stock keeping unit [brand-model-color-size])\nprice_override null?\n\nDiscounts\nid\ncode\ndiscout_type(%or fixed)\nvalue\nstart_date\nend_date\nnumber_of_uses\nis_active\n\nCity\nid\ncity_name\n(fk)its own shipping rule\n\nShipping_rules\nid\nrule_name\nprice\nfree_shipping_threshold (minimal amount to get free shipping)\n\nOrders\nid\nuser_id\ndiscount_id\nsubtotal (total amount to be calculated later)\nshipping_status(pending, shipped, delivered, cancelled)\ncity\nshipping_fee (at that time )\ntransaction_id?\ncreated_at\n\nOrder_items\nid\nquality\nprice_at_purchase\n\nUser&Admin\nid\nfirst_name\nlast_name\nemail\npassword_hash\nrole(customer || admin)\ncreated_at\n\nRefunds(to log refund transactions)\nid\norder_id\nadmin_user_id(admin who approved the refund)\namount\nreason\nstatus(pending, processed, failed)\ncreated_at\n\nrefund_items(tracking items came back)\nid\nrefund_id\nvariant_id\nquantity\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
